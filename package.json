{
  "name": "ally-desktop",
  "productName": "올리 메신저",
  "version": "0.1.20",
  "description": "올리(Ally) 설치형 메신저 — Windows",
  "main": "main.js",
  "author": "Ally <official@allywork.kr>",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "dist:store": "npm test && node build/check-store-identity.mjs && electron-builder --win appx --publish never",
    "test": "node --test \"test/**/*.test.mjs\"",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never -c.productName='Olly Messenger' -c.mac.identity=- -c.mac.hardenedRuntime=false '-c.mac.extendInfo.CFBundleDisplayName=올리 메신저' '-c.artifactName=Olly-Messenger-Mac-${version}-arm64.${ext}'"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "kr.allywork.messenger",
    "productName": "올리 메신저",
    "executableName": "Olly Messenger",
    "artifactName": "Olly-Messenger-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "chosahoo",
        "repo": "olly-desktop"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "올리 메신저",
      "runAfterFinish": true,
      "installerSidebar": "build/sidebar.bmp",
      "uninstallerSidebar": "build/sidebar.bmp"
    },
    "appx": {
      "identityName": "STORE_IDENTITY_NAME",
      "publisher": "CN=STORE_PUBLISHER_ID",
      "publisherDisplayName": "STORE_PUBLISHER_DISPLAY_NAME",
      "applicationId": "OllyMessenger",
      "displayName": "올리 메신저",
      "backgroundColor": "#0a7d43",
      "languages": [
        "ko-KR",
        "en-US"
      ],
      "customExtensionsPath": "build/appx-extensions.xml",
      "artifactName": "Olly-Messenger-Store-${version}.${ext}"
    }
  }
}
